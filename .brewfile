tap 'anomalyco/tap'
tap 'oven-sh/bun'
tap 'jorgelbg/tap'

cask_args appdir: '~/Applications'

cask 'vlc'
cask 'telegram'
cask 'obsidian'
cask 'google-chrome'
cask 'calibre'
cask 'icon-composer'
cask 'font-0xproto-nerd-font'
cask 'font-ubuntu-mono-nerd-font'
cask 'ghostty'
cask 'obs'
cask 'claude-code'
cask 'tablepro'
cask 'zulu@17'
cask 'dbeaver-community'
cask 'docker-desktop'

cask 'chatgpt'
cask 'claude'
cask 'opencode-desktop'

# --- Shared across machine users

cask 'qbittorrent', args: { appdir: '/Applications' }
cask 'maintenance', args: { appdir: '/Applications' }

# --- Brews

brew 'ansible'
brew 'nvm'
brew 'eza'
brew 'tmux'
brew 'nvim'
brew 'mas'
brew 'watchman'
brew 'rbenv'
brew 'pyenv'
brew 'jenv'
brew 'ruby-build'
brew 'nmap'
brew 'ios-deploy'
brew 'htop'
brew 'zsh-autosuggestions'
brew 'fzf'
brew 'redis'
brew 'gnupg'
brew 'httpie'
brew 'ipmitool'
brew 'scrcpy'
brew 'unar'
brew 'pnpm'
brew 'typewritten'
brew 'ripgrep'
brew 'fd'
brew 'unzip'
brew 'anomalyco/tap/opencode'
brew 'wget'
brew 'luarocks'
brew 'tree-sitter-cli'
brew 'oven-sh/bun/bun'
brew 'litecli' # CLI for SQLite Databases with auto-completion and syntax highlighting
brew 'uv' # uv is a fast Python package manager by Astral.
brew 'postgresql@18'
brew 'flyctl'
brew 'pinentry-mac'
brew 'pinentry-touchid'
brew 'gh'

