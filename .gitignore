# Ignore everything in $HOME by default
*

# Allow directories so git will descend into them
!zsh_tool/
!.gnupg/
!.config/ghostty/*
!.config/homebrew/*
!.config/nvim/*
!.config/glow/*


# Now allow the specific dotfiles you want tracked
!zsh_tool/*
!.gnupg/gpg-agent.conf

!.tmux.conf
!.zprofile
!.zshrc
!opencode.json
!README.md
